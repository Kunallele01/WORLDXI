<?xml version="1.0" encoding="utf-8"?>
<!--
  A football, in the app's single gold accent.

  DRAWN RATHER THAN DETAILED. An adaptive icon is masked to a circle on most
  launchers and is often rendered at 48dp, so the classic thirty-two-panel ball
  turns to mud at the size it is actually seen. This keeps the one shape the eye
  reads as "football" instantly — the central pentagon with seams running to the
  rim — and drops everything that would only survive at poster size.

  The ball sits inside the 72dp safe zone, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The ball. -->
    <path
        android:fillColor="#F5C518"
        android:pathData="M54,24 A30,30 0 1,1 53.99,24 Z" />

    <!-- Central pentagon, punched back out to the background colour. -->
    <path
        android:fillColor="#0C0D0F"
        android:pathData="M54,43 L64.46,50.6 L60.47,62.9 L47.53,62.9 L43.54,50.6 Z" />

    <!-- Seams, running from each pentagon vertex to the rim. -->
    <group>
        <path
            android:strokeColor="#0C0D0F"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M54,43 L54,24" />
        <path
            android:strokeColor="#0C0D0F"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M64.46,50.6 L82.53,44.73" />
        <path
            android:strokeColor="#0C0D0F"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M60.47,62.9 L71.63,78.27" />
        <path
            android:strokeColor="#0C0D0F"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M47.53,62.9 L36.37,78.27" />
        <path
            android:strokeColor="#0C0D0F"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M43.54,50.6 L25.47,44.73" />
    </group>
</vector>
